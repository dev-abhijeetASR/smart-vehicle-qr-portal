# Smart Vehicle QR Portal Configuration
PORT=3000

# Vehicle Registration Number displayed on portal by default
DEFAULT_VEHICLE=MH 14 ML 3751

# Telegram Bot Credentials (Get from @BotFather and @userinfobot)
# 1. Message @BotFather on Telegram -> /newbot -> Copy API Token (e.g. 7912345678:AAHk...)
TELEGRAM_BOT_TOKEN=

# 2. Message @userinfobot on Telegram -> Copy your numerical Chat Id (e.g. 790475932)
TELEGRAM_CHAT_ID=

# (Optional) Public base URL when hosted on Vercel or custom domain
PUBLIC_BASE_URL=https://your-domain.vercel.app/scanner-portal.html
